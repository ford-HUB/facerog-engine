FRE_MODEL_DIR=app/ml/weights
FRE_DETECTOR_MODEL_FILE=det_10g.onnx
FRE_EMBEDDER_MODEL_FILE=w600k_r50.onnx
FRE_USE_GPU=true

FRE_DATASET_DIR=datasets/faces

FRE_DETECTION_INPUT_SIZE=640
FRE_DETECTION_CONFIDENCE_THRESHOLD=0.5
FRE_DETECTION_NMS_THRESHOLD=0.4
FRE_MIN_FACE_SIZE_PIXELS=24

FRE_MATCH_THRESHOLD=0.40
FRE_TOP_K=3

FRE_VIDEO_SOURCE=0
FRE_VIDEO_AUTOSTART=true
FRE_VIDEO_FRAME_WIDTH=960
FRE_STREAM_JPEG_QUALITY=80
FRE_STREAM_MAX_FPS=25

# Tracking (ByteTrack)
FRE_TRACK_HIGH_THRESHOLD=0.6
FRE_TRACK_LOW_THRESHOLD=0.2
FRE_TRACK_NEW_THRESHOLD=0.7
FRE_TRACK_BUFFER_FRAMES=30
FRE_TRAJECTORY_LENGTH=60

FRE_RECOGNITION_INTERVAL_FRAMES=5
FRE_REVERIFY_INTERVAL_FRAMES=90
FRE_TRACK_EMBEDDING_HISTORY=10
FRE_ANGLED_FACE_THRESHOLD_DEGREES=15
FRE_ZOOM_SIZE_PIXELS=256
FRE_CHECK_IN_COOLDOWN_MINUTES=60
FRE_TV_DISPLAY_SECONDS=3
FRE_TV_HEARTBEAT_SECONDS=5

FRE_MAX_UPLOAD_SIZE_BYTES=10485760
